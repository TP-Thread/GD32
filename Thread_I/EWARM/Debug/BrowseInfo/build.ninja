##IAR Ninja build file


#Rules
rule COMPILER_XCL
  command = D$:\EIDE\IAR\common\bin\XclFileGenerator.exe $xclcommand -f "$rspfile_name"
  description = IAR_NEW_TOOL+++COMPILER_XCL+++$in+++D$:\EIDE\IAR\common\bin\XclFileGenerator.exe $flags
  rspfile = $rspfile_name
  rspfile_content = $flags

rule INDEXER
  command = D$:\EIDE\IAR\common\bin\SourceIndexer.exe $flags
  depfile = $out.dep
  description = IAR_NEW_TOOL+++INDEXER+++$out+++D$:\EIDE\IAR\common\bin\SourceIndexer.exe $flags

rule MAKEBROWSE
  command = D$:\EIDE\IAR\common\bin\makeBrowseData.exe $flags
  description = IAR_NEW_TOOL+++MAKEBROWSE+++$out+++D$:\EIDE\IAR\common\bin\makeBrowseData.exe $flags

rule PDBLINK
  command = D$:\EIDE\IAR\common\bin\PbdLink.exe $flags
  description = IAR_NEW_TOOL+++PDBLINK+++$out+++D$:\EIDE\IAR\common\bin\PbdLink.exe $flags



